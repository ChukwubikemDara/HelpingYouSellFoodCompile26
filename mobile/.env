# Serve fixtures from src/mock.ts instead of calling the backend.
# Set to 0 once the real API is up, and set EXPO_PUBLIC_API_URL to its address
# (a phone cannot reach the laptop via "localhost", use the LAN IP).
EXPO_PUBLIC_API_MOCK=1

# Where the store portal (../web) is hosted. Shows "I run a store" on the Profile tab.
# For a demo off your laptop, put the laptop's network address in .env.local instead
# (not committed), e.g. EXPO_PUBLIC_PORTAL_URL=http://192.168.1.20:5173
EXPO_PUBLIC_PORTAL_URL=
