AWS_REGION=us-east-1
DYNAMODB_MERCHANTS_TABLE=HelpingYouSellFood-Merchants
DYNAMODB_DEALS_TABLE=HelpingYouSellFood-Deals
DYNAMODB_RESERVATIONS_TABLE=HelpingYouSellFood-Reservations
# Optional local DynamoDB endpoint. Leave unset on AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000
# Use AWS_PROFILE locally or an IAM role on AWS; never put keys in NEXT_PUBLIC_*.
DYNAMODB_CUSTOMERS_TABLE=HelpingYouSellFood-Customers
# Local launcher config (run-local.sh sets these automatically):
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
# LOCAL_DEVELOPMENT=1
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
# PLAN_GATE=0
# PLATFORM_FEE_CENTS_PER_PICKUP=0
